generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                     String                  @id @default(uuid())
  company_name           String
  plan                   Plan                    @default(BASIC)
  status                 CompanyStatus           @default(ACTIVE)
  slug                   String                  @unique
  logo                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  address                String?
  gstin_uin              String?
  state_name             String?
  state_code             String?
  contact                String?
  hsn_sac                String?
  bill_to                String?
  buyer_name             String?
  buyer_address          String?
  buyer_gstin_uin        String?
  buyer_state_name       String?
  buyer_state_code       String?
  cgst_rate              Float?
  sgst_rate              Float?
  income_tax_rate        Float?
  labour_cess_rate       Float?
  cgst_tds_rate          Float?
  sgst_tds_rate          Float?
  additional_deposit     Float?
  bank_name              String?
  branch_name            String?
  ifsc_code              String?
  swift_code             String?
  account_no             String?
  account_holder_name    String?
  module_access          Json?                  @map("module_access")
  approved_by_ranges     Json?                  @map("approved_by_ranges")
  ayMasters              AYMaster[]
  accounts               Account[]
  attendances            Attendance[]
  bankTransactions       BankBookTransaction[]
  belongingsTransfers    BelongingsTransfer[]
  capitalSOR             CapitalSOR[]
  capitalSorPrices       CapitalSORPrice[]
  cashBooks              CashBook[]
  cashTransactions       CashBookTransaction[]
  chequePrints           ChequePrint[]
  departments            Department[]
  documents              Document[]
  employees              Employee[]
  employeePrices         EmployeePrice[]
  itemManagements        ItemManagement[]
  itemMasters            ItemMaster[]
  itemWorkTypePrices     ItemWorkTypePrice[]
  locations              Location[]
  Material               Material[]
  MaterialPrefix         MaterialPrefix[]
  MaterialPriceHistory   MaterialPriceHistory[]
  modulePermissions      ModulePermission[]
  parties                Party[]
  partySupplierItemPrices PartySupplierItemPrice[]
  projects               Project[]
  projectDeposits        ProjectDeposit[]
  projectDocuments       ProjectDocument[]
  projectPhotoStages     ProjectPhotoStage[]
  projectPhotos          ProjectPhoto[]
  projectLocations       ProjectLocation[]
  projectStatusTrackings ProjectStatusTracking[]
  projectWorkTypes       ProjectWorkType[]
  purchaseEntries        PurchaseEntry[]
  purchaseEntryLocations PurchaseEntryLocation[]
  purchaseEntryMaterials PurchaseEntryMaterial[]

  soritems                    SORItem[]
  subcontractors              Subcontractor[]
  subcontractorRates          SubcontractorRate[]
  tasks                       Task[]
  tempProjectDocuments        TempProjectDocument[]
  negotiationPrices           NegotiationPrice[]
  units                       Unit[]
  users                       User[]
  vardhis                     Vardhi[]
  vardhiAdditionalItems       VardhiAdditionalItem[]
  vardhiEmployees             VardhiEmployee[]
  vardhiEstimations           VardhiEstimation[]
  vardhiEstimationItems       VardhiEstimationItem[]
  vardhiExpenses              VardhiExpense[]
  vardhiInvoices              VardhiInvoice[]
  vardhiItems                 VardhiItem[]
  vardhiWaterWorksDepartments VardhiWaterWorksDepartment[]
  workTypes                   WorkType[]
  zoneMasters                 ZoneMaster[]
  activities                  Activity[]                   @relation("CompanyActivities")
  projectAreas                ProjectArea[]
  projectItems                ProjectItem[]
  sorGroups                   SORGroup[]
  correspondence              Correspondence[]
  designations                Designation[]
  leaveTypes                  LeaveType[]
  leaveRequests               LeaveRequest[]
  holidays                    Holiday[]
  jobs                        Job[]
  candidates                  Candidate[]
  performanceReviews          PerformanceReview[]
  employeeDocuments           EmployeeDocument[]
  announcements               Announcement[]
  payrollSalaryComponents     PayrollSalaryComponent[]
  payrollFinancialYears       PayrollFinancialYear[]
  employeeSalaries            EmployeeSalary[]
  payrollRuns                 PayrollRun[]
  reimbursementTypes          ReimbursementType[]
  reimbursementRequests       ReimbursementRequest[]
  loans                       Loan[]
  ledgers                     Ledger[]

  @@map("Company")
}

model Employee {
  id                         String    @id @default(uuid())
  company_id                 String    @map("company_id")
  employee_code              String?   @map("employee_code")
  first_name                String?          @map("first_name")
  last_name                  String?   @map("last_name")
  middle_name                String?   @map("middle_name")
  email                      String?   @map("email")
  phone                      String?   @map("phone")
  alternate_phone            String?   @map("alternate_phone")
  gender                     String?   @map("gender")
  date_of_birth              DateTime? @map("date_of_birth")
  blood_group                String?   @map("blood_group")
  marital_status             String?   @map("marital_status")
  nationality                String?   @map("nationality")
  photo                      String?   @map("photo")
  address                    String?   @map("address")
  city                       String?   @map("city")
  state                      String?   @map("state")
  country                    String?   @map("country")
  pincode                    String?   @map("pincode")
  name                       String
  department_id              String?   @map("department_id")
  designation_id             String?   @map("designation_id")
  joining_date               DateTime? @map("joining_date")
  confirmation_date          DateTime? @map("confirmation_date")
  employment_type            String?   @map("employment_type")
  shift                      String?   @map("shift")
  reporting_manager          String?   @map("reporting_manager")
  work_location              String?   @map("work_location")
  aadhaar                    String?   @map("aadhaar")
  pan                        String?   @map("pan")
  passport                   String?   @map("passport")
  driving_license            String?   @map("driving_license")
  account_holder_name        String?   @map("account_holder_name")
  bank_name                  String?   @map("bank_name")
  account_number             String?   @map("account_number")
  ifsc_code                  String?   @map("ifsc_code")
  branch                     String?   @map("branch")
  emergency_contact_name     String?   @map("emergency_contact_name")
  emergency_contact_relation String?   @map("emergency_contact_relation")
  emergency_contact_phone    String?   @map("emergency_contact_phone")
  status                     String?   @default("ACTIVE")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  company                 Company             @relation(fields: [company_id], references: [id])
  department              Department?         @relation("EmployeeDepartment", fields: [department_id], references: [id])
  designation             Designation?        @relation(fields: [designation_id], references: [id])
  prices                  EmployeePrice[]
  vardhiEmployees         VardhiEmployee[]
  purchaseEntriesReceived PurchaseEntry[]     @relation("PurchaseEntry_received_byToEmployee")
  leaveRequests           LeaveRequest[]
  documents               EmployeeDocument[]
  performanceReviews      PerformanceReview[]
  employeeSalaries        EmployeeSalary[]
  payrollItems            PayrollItem[]
  payslips                Payslip[]
  reimbursementRequests   ReimbursementRequest[]
  loans                   Loan[]

  @@index([company_id])
  @@index([name])
  @@index([department_id])
  @@index([designation_id])
  @@index([employee_code])
  @@index([status])
}

model Subcontractor {
  id         String              @id @default(uuid())
  company_id String              @map("company_id")
  name       String
  unit_id    String?             @map("unit_id")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  capitalSOR CapitalSOR[]
  company    Company             @relation(fields: [company_id], references: [id])
  rates      SubcontractorRate[]
  unit       Unit?               @relation(fields: [unit_id], references: [id])

  @@index([company_id])
  @@index([name])
}

model SubcontractorRate {
  id               String        @id @default(uuid())
  company_id       String        @map("company_id")
  subcontractor_id String        @map("subcontractor_id")
  rate             Decimal       @db.Decimal(12, 2)
  start_date       DateTime      @default(now()) @map("start_date")
  expiry_date      DateTime?     @map("expiry_date")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  company          Company       @relation(fields: [company_id], references: [id])
  subcontractor    Subcontractor @relation(fields: [subcontractor_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([subcontractor_id])
  @@index([subcontractor_id, start_date, expiry_date])
}

model EmployeePrice {
  id          String    @id @default(uuid())
  company_id  String    @map("company_id")
  employee_id String    @map("employee_id")
  price       Decimal   @db.Decimal(18, 2)
  start_date  DateTime  @default(now()) @map("start_date")
  expiry_date DateTime? @map("expiry_date")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [company_id], references: [id])
  employee    Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([employee_id])
  @@index([employee_id, start_date, expiry_date])
}

model Department {
  id           String        @id @default(uuid())
  company_id   String        @map("company_id")
  name         String
  code         String?       @map("code")
  manager_name String?       @map("manager_name")
  phone        String?       @map("phone")
  email        String?       @map("email")
  description  String?       @map("description")
  status       String?       @default("ACTIVE")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [company_id], references: [id])
  itemMasters  ItemMaster[]
  employees    Employee[]    @relation("EmployeeDepartment")
  designations Designation[]

  @@unique([company_id, name])
  @@index([company_id])
}

model Designation {
  id            String      @id @default(uuid())
  company_id    String      @map("company_id")
  department_id String?     @map("department_id")
  name          String
  level         Int?        @map("level")
  description   String?     @map("description")
  status        String?     @default("ACTIVE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  company       Company     @relation(fields: [company_id], references: [id])
  department    Department? @relation(fields: [department_id], references: [id])
  employees     Employee[]

  @@unique([company_id, name])
  @@index([company_id])
  @@index([department_id])
}

model LeaveType {
  id            String         @id @default(uuid())
  company_id    String         @map("company_id")
  name          String
  days          Int            @default(0)
  carry_forward Boolean        @default(false) @map("carry_forward")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [company_id], references: [id])
  leaveRequests LeaveRequest[]

  @@unique([company_id, name])
  @@index([company_id])
}

model LeaveRequest {
  id            String    @id @default(uuid())
  company_id    String    @map("company_id")
  employee_id   String    @map("employee_id")
  leave_type_id String    @map("leave_type_id")
  from_date     DateTime  @map("from_date")
  to_date       DateTime  @map("to_date")
  reason        String?   @map("reason")
  status        String    @default("PENDING")
  approved_by   String?   @map("approved_by")
  remarks       String?   @map("remarks")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [company_id], references: [id])
  employee      Employee  @relation(fields: [employee_id], references: [id])
  leaveType     LeaveType @relation(fields: [leave_type_id], references: [id])

  @@index([company_id])
  @@index([employee_id])
  @@index([leave_type_id])
  @@index([status])
}

model Holiday {
  id          String   @id @default(uuid())
  company_id  String   @map("company_id")
  title       String
  date        DateTime
  type        String?  @default("PUBLIC")
  description String?  @map("description")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@index([date])
}

model Job {
  id           String      @id @default(uuid())
  company_id   String      @map("company_id")
  title        String
  department   String?     @map("department")
  vacancy      Int?        @default(1)
  experience   String?     @map("experience")
  salary_range String?     @map("salary_range")
  location     String?     @map("location")
  status       String?     @default("OPEN")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  company      Company     @relation(fields: [company_id], references: [id])
  candidates   Candidate[]

  @@index([company_id])
  @@index([status])
}

model Candidate {
  id         String   @id @default(uuid())
  company_id String   @map("company_id")
  job_id     String?  @map("job_id")
  name       String
  email      String?  @map("email")
  phone      String?  @map("phone")
  resume     String?  @map("resume")
  status     String?  @default("APPLIED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [company_id], references: [id])
  job        Job?     @relation(fields: [job_id], references: [id])

  @@index([company_id])
  @@index([job_id])
  @@index([status])
}

model PerformanceReview {
  id           String   @id @default(uuid())
  company_id   String   @map("company_id")
  employee_id  String   @map("employee_id")
  reviewer     String?  @map("reviewer")
  rating       Int?     @map("rating")
  goals        String?  @map("goals")
  achievements String?  @map("achievements")
  comments     String?  @map("comments")
  review_date  DateTime @default(now()) @map("review_date")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [company_id], references: [id])
  employee     Employee @relation(fields: [employee_id], references: [id])

  @@index([company_id])
  @@index([employee_id])
}

model EmployeeDocument {
  id            String    @id @default(uuid())
  company_id    String    @map("company_id")
  employee_id   String    @map("employee_id")
  document_name String    @map("document_name")
  file          String?   @map("file")
  expiry_date   DateTime? @map("expiry_date")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [company_id], references: [id])
  employee      Employee  @relation(fields: [employee_id], references: [id])

  @@index([company_id])
  @@index([employee_id])
}

model Document {
  id                   String   @id @default(uuid())
  company_id           String   @map("company_id")
  document_name        String   @map("document_name")
  expire_date          DateTime @map("expire_date")
  file                 String?  @map("file")
  file_type            String?  @map("file_type")
  reminder_date        DateTime @map("reminder_date")
  reminder_enabled     Boolean  @default(true) @map("reminder_enabled")
  reminder_days_before Int?     @map("reminder_days_before")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company  @relation(fields: [company_id], references: [id])

  @@index([company_id])
}

model Announcement {
  id           String    @id @default(uuid())
  company_id   String    @map("company_id")
  title        String
  description  String?   @map("description")
  publish_date DateTime  @default(now()) @map("publish_date")
  expiry_date  DateTime? @map("expiry_date")
  priority     String?   @default("NORMAL")
  status       String?   @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@index([status])
}

// ──────────────────────────────────────────────
// PAYROLL MODULE
// ──────────────────────────────────────────────

model PayrollSalaryComponent {
  id               String   @id @default(uuid())
  company_id       String   @map("company_id")
  code             String?  @map("code")       // stable key e.g. BASIC, HRA, PF, TDS
  name             String
  type             String   @default("EARNING") // EARNING / DEDUCTION
  calculation_type String   @default("FIXED")   // FIXED / PERCENTAGE
  default_value    Float?   @default(0)
  percentage_of_id String?  @map("percentage_of_id")
  is_active        Boolean  @default(true)
  is_standard      Boolean  @default(false) @map("is_standard")
  sort_order       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company         Company                    @relation(fields: [company_id], references: [id])
  percentageOf    PayrollSalaryComponent?    @relation("SalaryComponentPercentageOf", fields: [percentage_of_id], references: [id])
  percentageOfFor PayrollSalaryComponent[]   @relation("SalaryComponentPercentageOf")
  salaryComponents     EmployeeSalaryComponent[]
  payrollItemComponents PayrollItemComponent[]

  @@unique([company_id, name])
  @@unique([company_id, code])
  @@index([company_id])
  @@index([type])
  @@map("payroll_salary_components")
}

model PayrollFinancialYear {
  id         String   @id @default(uuid())
  company_id String   @map("company_id")
  name       String   // e.g., "2025-2026"
  start_date DateTime @map("start_date")
  end_date   DateTime @map("end_date")
  is_closed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company     Company         @relation(fields: [company_id], references: [id])
  periods     PayrollPeriod[]
  payrollRuns PayrollRun[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("payroll_financial_years")
}

model PayrollPeriod {
  id                String   @id @default(uuid())
  financial_year_id String   @map("financial_year_id")
  month             Int      // 1-12
  year              Int      // e.g., 2025
  start_date        DateTime @map("start_date")
  end_date          DateTime @map("end_date")
  is_processed      Boolean  @default(false)
  is_closed         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  financialYear PayrollFinancialYear @relation(fields: [financial_year_id], references: [id])
  payrollRuns   PayrollRun[]

  @@unique([financial_year_id, month, year])
  @@index([financial_year_id])
  @@map("payroll_periods")
}

model EmployeeSalary {
  id             String   @id @default(uuid())
  company_id     String   @map("company_id")
  employee_id    String   @map("employee_id")
  effective_from DateTime? @map("effective_from")
  effective_to   DateTime? @map("effective_to")
  gross_salary   Float?   @default(0) @map("gross_salary")
  status         String   @default("ACTIVE") // ACTIVE / INACTIVE
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company    Company                  @relation(fields: [company_id], references: [id])
  employee   Employee                 @relation(fields: [employee_id], references: [id])
  components EmployeeSalaryComponent[]

  @@index([company_id])
  @@index([employee_id])
  @@index([status])
  @@map("employee_salaries")
}

model EmployeeSalaryComponent {
  id                 String   @id @default(uuid())
  employee_salary_id String   @map("employee_salary_id")
  salary_component_id String  @map("salary_component_id")
  amount             Float?   @default(0)
  percentage         Float?   @default(0)
  calculation_type   String   @default("FIXED") // FIXED / PERCENTAGE
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employeeSalary  EmployeeSalary        @relation(fields: [employee_salary_id], references: [id], onDelete: Cascade)
  salaryComponent PayrollSalaryComponent @relation(fields: [salary_component_id], references: [id])

  @@index([employee_salary_id])
  @@index([salary_component_id])
  @@map("employee_salary_components")
}

model PayrollRun {
  id               String   @id @default(uuid())
  company_id       String   @map("company_id")
  financial_year_id String  @map("financial_year_id")
  period_id         String   @map("period_id")
  process_date     DateTime @default(now()) @map("process_date")
  total_employees  Int      @default(0)
  total_gross      Float    @default(0)
  total_earnings   Float    @default(0)
  total_deductions Float    @default(0)
  total_net        Float    @default(0)
  status           String   @default("DRAFT") // DRAFT / PROCESSED / FINALIZED
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company          @relation(fields: [company_id], references: [id])
  financialYear  PayrollFinancialYear @relation(fields: [financial_year_id], references: [id])
  period         PayrollPeriod    @relation(fields: [period_id], references: [id])
  payrollItems   PayrollItem[]
  payslips       Payslip[]
  loanRepayments LoanRepayment[]

  @@index([company_id])
  @@index([financial_year_id])
  @@index([period_id])
  @@index([status])
  @@map("payroll_runs")
}

model PayrollItem {
  id               String   @id @default(uuid())
  payroll_run_id   String   @map("payroll_run_id")
  employee_id      String   @map("employee_id")
  employee_salary_id String? @map("employee_salary_id")
  gross_salary     Float    @default(0)
  total_earnings   Float    @default(0)
  total_deductions Float    @default(0)
  net_pay          Float    @default(0)
  status           String   @default("COMPUTED") // COMPUTED / CONFIRMED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payrollRun   PayrollRun          @relation(fields: [payroll_run_id], references: [id], onDelete: Cascade)
  employee     Employee            @relation(fields: [employee_id], references: [id])
  components   PayrollItemComponent[]
  payslip      Payslip?

  @@index([payroll_run_id])
  @@index([employee_id])
  @@map("payroll_items")
}

model PayrollItemComponent {
  id                 String   @id @default(uuid())
  payroll_item_id    String   @map("payroll_item_id")
  salary_component_id String  @map("salary_component_id")
  amount             Float    @default(0)
  type               String   // EARNING / DEDUCTION
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  payrollItem    PayrollItem            @relation(fields: [payroll_item_id], references: [id], onDelete: Cascade)
  salaryComponent PayrollSalaryComponent @relation(fields: [salary_component_id], references: [id])

  @@index([payroll_item_id])
  @@index([salary_component_id])
  @@map("payroll_item_components")
}

model Payslip {
  id              String   @id @default(uuid())
  payroll_item_id String   @unique @map("payroll_item_id")
  employee_id     String   @map("employee_id")
  payroll_run_id  String   @map("payroll_run_id")
  payslip_number  String   @map("payslip_number")
  generated_date  DateTime @default(now()) @map("generated_date")
  pdf_path        String?  @map("pdf_path")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payrollItem PayrollItem @relation(fields: [payroll_item_id], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employee_id], references: [id])
  payrollRun  PayrollRun  @relation(fields: [payroll_run_id], references: [id])

  @@index([employee_id])
  @@index([payroll_run_id])
  @@index([payslip_number])
  @@map("payslips")
}

// ──────────────────────────────────────────────
// REIMBURSEMENT MODULE
// ──────────────────────────────────────────────

model ReimbursementType {
  id          String   @id @default(uuid())
  company_id  String   @map("company_id")
  name        String
  description String?
  is_active   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company           Company               @relation(fields: [company_id], references: [id])
  reimbursementRequests ReimbursementRequest[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("reimbursement_types")
}

model ReimbursementRequest {
  id                     String   @id @default(uuid())
  company_id             String   @map("company_id")
  employee_id            String   @map("employee_id")
  reimbursement_type_id  String   @map("reimbursement_type_id")
  amount                 Float    @default(0)
  description            String?
  expense_date           DateTime @map("expense_date")
  status                 String   @default("PENDING") // PENDING / APPROVED / REJECTED / PAID
  approved_by            String?  @map("approved_by")
  approved_at            DateTime? @map("approved_at")
  paid_date              DateTime? @map("paid_date")
  remarks                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company            Company            @relation(fields: [company_id], references: [id])
