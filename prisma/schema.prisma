  itemMasters ItemMaster[]
  company     Company      @relation(fields: [company_id], references: [id])

  @@unique([company_id, name])
  @@index([company_id])
}

model ItemMaster {
  id           String       @id @default(uuid())
  company_id   String       @map("company_id")
  departmentId String?      @map("department_id")
  sorId        String       @map("sor_id")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  capitalSors  CapitalSOR[] @relation("CapitalSORToItemMaster")
  company      Company      @relation(fields: [company_id], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  sor          SORItem      @relation(fields: [sorId], references: [id])

  @@index([company_id])
}

model CapitalSORPrice {
  id            String     @id @default(uuid())
  company_id    String     @map("company_id")
  capitalSor_id String     @map("capital_sor_id")
  price         Decimal    @db.Decimal(18, 2)
  start_date    DateTime   @default(now()) @map("start_date")
  expiry_date   DateTime?  @map("expiry_date")
  createdAt     DateTime   @default(now())
  capitalSor    CapitalSOR @relation(fields: [capitalSor_id], references: [id], onDelete: Cascade)
  company       Company    @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@index([capitalSor_id])
  @@index([capitalSor_id, start_date, expiry_date])
}

model Activity {
  id         String     @id @default(cuid())
  companyId  String     @map("company_id")
  userId     String     @map("user_id")
  entityType String     @map("entity_type")
  entityId   String     @map("entity_id")
  action     ActionType
  title      String
  message    String
  metadata   Json?
  isRead     Boolean    @default(false) @map("is_read")
  createdAt  DateTime   @default(now()) @map("created_at")
  company    Company    @relation("CompanyActivities", fields: [companyId], references: [id], onDelete: Cascade)
  user       User       @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([isRead])
  @@map("activities")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String?          @map("user_id")
  targetRole Role             @default(SuperAdmin) @map("target_role")
  type       NotificationType @default(INFO)
  entity     String
  action     String
  entityId   String?          @map("entity_id")
  message    String
  link       String?
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  user       User?            @relation("UserNotifications", fields: [userId], references: [id])

  @@index([targetRole])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Material {
  id                     String                  @id
  company_id             String
  name                   String
  rate                   Decimal                 @default(0) @db.Decimal(15, 2)
  hsn_sac                String?
  unit_id                String?
  gst_percent            Decimal                 @default(18) @db.Decimal(5, 2)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  Company                Company                 @relation(fields: [company_id], references: [id])
  MaterialPriceHistory   MaterialPriceHistory[]
  purchaseEntryMaterials PurchaseEntryMaterial[]

  @@unique([company_id, name])
  @@index([company_id])
}

model MaterialPrefix {
  id         String   @id
  company_id String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Company    Company  @relation(fields: [company_id], references: [id])

  @@unique([company_id, name])
  @@index([company_id])
}

model MaterialPriceHistory {
  id          String    @id
  company_id  String
  material_id String
  rate        Decimal   @db.Decimal(15, 2)
  start_date  DateTime  @default(now())
  expire_date DateTime?
  createdAt   DateTime  @default(now())
  Company     Company   @relation(fields: [company_id], references: [id])
  Material    Material  @relation(fields: [material_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([material_id])
  @@index([start_date])
}

model vardhi_counter {
  id    String @id
  value Int    @default(0)
}

model SORGroup {
  id         String   @id @default(uuid())
  company_id String   @map("company_id")
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@map("SORGroup")
}

model Correspondence {
  id               String   @id @default(uuid())
  company_id       String   @map("company_id")
  project_id       String
  sr_no            Int
  type             String?
  docket_no        String?
  subject          String?
  document_content String?
  document_urls    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([project_id])
  @@map("correspondence")
}

model CompanyAccessSetting {
  id                 String   @id @default(uuid())
  allow_add_company  Boolean  @default(true) @map("allow_add_company")
  allow_edit_company Boolean  @default(true) @map("allow_edit_company")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("company_access_settings")
}

enum Plan {
  BASIC
  PRO
  ENTERPRISE
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum Role {
  SuperAdmin
  Admin
  Accountant
  DataEntry
  Supervisor
  Zone
  HR
  Manager
  Recruiter
}

enum OfficerStatus {
  CURRENT
  PAST
}

enum Permission {
  VIEW
  CREATE
  EDIT
  DELETE
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

model ZoneApproval {
  id             String   @id @default(uuid())
  company_id     String
  zone_id        String
  approved_vardhi_ids String @map("approved_vardhi_ids") @db.Text
  created_at     DateTime @default(now()) @map("created_at")
  updated_at     DateTime @updatedAt @map("updated_at")

  zone           ZoneMaster @relation(fields: [zone_id], references: [id], onDelete: Cascade)

  @@unique([company_id, zone_id])
  @@index([company_id, zone_id])
}
